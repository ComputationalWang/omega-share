{
  "name": "omega-share",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.json && tsc -p assets",
    "lint": "eslint .",
    "test": "bun test --pass-with-no-tests",
    "e2e": "bun run --filter @omega/extension build:e2e && playwright test --project=e2e --project=e2e-sync --project=e2e-tunnel",
    "e2e:real": "playwright test --project=e2e-real",
    "perf": "bun perf/run.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@omega/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0"
  }
}
