{
  "name": "omega-share",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.json && tsc -p assets",
    "lint": "eslint .",
    "test": "bun test --pass-with-no-tests",
    "e2e": "bun run --filter @omega/extension build:e2e && playwright test --project=e2e --project=e2e-sync --project=e2e-tunnel",
    "ext:store": "bun run --filter @omega/extension store",
    "ext:amo": "bun apps/extension/store/amo-cli.ts",
    "ext:firefox": "bun run --filter @omega/extension build:firefox && bun test ./apps/extension/test/manifest.test.ts ./apps/extension/test/store.test.ts ./apps/extension/test/sources.test.ts && playwright test --project=ext-firefox && playwright test --project=perf perf/extension-firefox.perf.ts",
    "e2e:reap": "bun e2e/support/reap.ts",
    "e2e:real": "bun e2e/support/headed.ts playwright test --project=e2e-real",
    "perf": "bun perf/run.ts",
    "affected": "bun scripts/affected.ts",
    "perf:submit": "bun perf/runner/submit.ts",
    "perf:result": "bun perf/runner/result.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@omega/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@puppeteer/browsers": "3.2.4",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "valibot": "^1.5.0",
    "web-ext": "^10.7.0"
  }
}
