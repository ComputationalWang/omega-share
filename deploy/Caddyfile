# Caddy in front of the loopback server (ADR 0020). TLS by ACME; HTTP redirects to HTTPS.
# The server owns CSP, HSTS and every security header, and the client IP: Caddy appends the
# peer to X-Forwarded-For and ignores the client's own value (no proxy is trusted). No access log (D6),
# and the default logger drops request IPs and headers, which `http.log.error` would write on a 502 (OME-386).
{
	# No admin API: the app's sandbox may open loopback TCP, and the API could rewrite Caddy's config.
	admin off
	log default {
		output stderr
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			# ACME challenge entries name the validator's address.
			remote delete
			wrap json
		}
	}
	servers {
		protocols h1 h2
		# Slow-loris and oversize heads stop here, in front of the origin (#254, ADR 0050). max_header_size sits under the
		# server's own 16 KiB refusal (Go allows a little slack above it). The server holds no per-client connection cap
		# behind the proxy: nftables' per-source `ct count` is that limit. No write timeout: it would cut slow downloads of
		# the site's big assets, and the server has its own write-stall guard. Upgraded WebSockets are exempt from these.
		max_header_size 12KiB
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

omega-share.duckdns.org {
	encode zstd gzip
	# No trusted-proxy setting and no header_up on X-Forwarded-For: Caddy then drops any client-sent X-Forwarded-* and sets
	# X-Forwarded-For to the TCP peer, so the rightmost entry the server reads (TRUST_PROXY=loopback) is the real client
	# and a remote client cannot pose as 127.0.0.1. docs/ops/switch-to-rust.md checks this with a forged header.
	reverse_proxy 127.0.0.1:8787 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
