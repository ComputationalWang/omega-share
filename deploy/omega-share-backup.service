# Runs deploy/backup.sh (VACUUM INTO snapshot) as the service user. Started by the timer.
[Unit]
Description=omega-share nightly DB snapshot

# Until the server's first start there is nothing to back up (and sqlite3 would create an empty DB).
ConditionPathExists=/var/lib/omega-share/omega.db

[Service]
Type=oneshot
User=omega-share
Group=omega-share
UMask=0027
ExecStart=/usr/local/lib/omega-share/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/omega-share /var/backups/omega-share
CapabilityBoundingSet=
