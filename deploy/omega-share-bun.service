# omega-share server, the Bun release (ADR 0020). Kept for the 7 days after the switch to Rust (ADR 0050) so a rollback
# is one deploy: `deploy/deploy.sh --server bun`. Delete this file, its provision.sh lines and the polkit entry with the
# Bun server (S13). Installed to /etc/systemd/system by deploy/provision.sh.
#
# Starts only when `current` holds a Bun release (not omega-server); omega-share.service is the Rust twin and the two never
# run together: deploy/deploy.sh stops the other one. No Conflicts= between them: both are enabled, and a boot would
# otherwise queue two conflicting start jobs.
[Unit]
Description=omega-share server (Bun, rollback)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/omega-share/current/apps/server/src/index.ts
ConditionPathExists=!/opt/omega-share/current/omega-server
# deploy can't reset-failed (polkit allows start/stop/restart only), so allow a burst of restarts.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=omega-share
Group=omega-share
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=TRUST_PROXY=loopback
Environment=PUBLIC_ORIGIN=https://omega-share.duckdns.org
Environment=SITE_ORIGIN=https://omega-share.duckdns.org
Environment=STATIC_DIR=/opt/omega-share/current/apps/web/dist
Environment=DB_PATH=/var/lib/omega-share/omega.db
Environment=METRICS_PORT=9464
EnvironmentFile=-/etc/omega-share/env
ExecStart=/usr/local/bin/bun /opt/omega-share/current/apps/server/src/index.ts
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10s
StateDirectory=omega-share
StateDirectoryMode=0700

# Sandbox (the pre-switch unit; no MemoryDenyWriteExecute: Bun's JIT needs writable+executable pages)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/omega-share
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryMax=512M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
