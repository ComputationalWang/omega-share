# Pinned tools for the Rust server's release build (OME-1174, ADR 0050). Read by scripts/build-server-rs.sh,
# deploy/check-server-binary.sh and scripts/install-server-rs-tools.sh. A bump changes this file and nothing else.
#
# GLIBC: the binary is linked against this glibc and must not use a newer symbol. 2.35 is Ubuntu 22.04's; 24.04 (2.39)
# and 26.04 (newer still) are above it, so the binary runs on any supported Ubuntu LTS box and survives a release upgrade.
# The release build used symbols up to GLIBC_2.34; the artifact check fails a build that needs more than the pin.
GLIBC=2.35
# zig is only the cross C compiler/linker. The sha256 values are the ones ziglang.org/download/index.json lists for 0.15.2.
ZIG_VERSION=0.15.2
ZIG_SHA256_X86_64=02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239
ZIG_SHA256_AARCH64=958ed7d1e00d0ea76590d27666efbf7a932281b3d7ba0c6b01b0ff26498f667f
# INFORMATIONAL: nothing in this repo compares this value. `cargo install --locked --version <this> cargo-zigbuild` is verified by cargo itself against the crates.io index checksum, which is the same value; it is recorded so a change of that checksum is visible in review.
CARGO_ZIGBUILD_VERSION=0.23.4
CARGO_ZIGBUILD_CRATE_SHA256=0b0c2fe7d5f1a782047272e3fc1cd44214c450776bbde564bf92b9776dc2d781
# Caddy, for checking deploy/Caddyfile locally without root (OME-1174 review): linux_amd64 tarball of
# https://github.com/caddyserver/caddy/releases/tag/v2.11.7, sha256 as computed after verifying the release's sha512 list.
CADDY_VERSION=2.11.7
CADDY_SHA256_X86_64=727b91701a392de6ebc5027509f548bf39979e5216340d0faed8fa5e69c84f8b
