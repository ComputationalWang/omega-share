# /etc/sudoers.d/omega-backup (0440; check it with visudo -cf before installing). Lets the deploy
# user run the rsync sender as the service user, so deploy/backup/pull.sh can read the 0600
# snapshots. This is no more than deploy already has: it ships the code omega-share runs. It is not
# read-only: the `*` lets server-parsed options like --log-file or --write-batch write as omega-share.
deploy ALL=(omega-share) NOPASSWD: /usr/bin/rsync --server --sender *
